#!/usr/bin/env python
"""Builds lampblack_core, the one LAMPBLACK GDExtension (FND-02).

  scons platform=linux target=template_debug arch=x86_64
  scons platform=linux target=template_release arch=x86_64 tests=yes

src/core/ is engine-free C++ and is also linked into the doctest runner
(bin/lampblack_core_tests) when tests=yes. src/godot/ holds the ClassDB bindings.
"""
import json
import os
import subprocess

import SCons.Errors

from SCons.Script import ARGUMENTS

# FND-04: CI keeps compiled objects (godot-cpp's above all) in a cache between runs.
if os.environ.get("LB_SCONS_CACHE"):
    CacheDir(os.environ["LB_SCONS_CACHE"])

env = SConscript("godot-cpp/SConstruct", {"api_version": "4.7"})

# Cross-platform determinism (FND-06): no fused multiply-add, no fast-math, no native ISA.
if env.get("is_msvc", False):
    env.Append(CCFLAGS=["/fp:precise"])
else:
    env.Append(CCFLAGS=["-ffp-contract=off", "-fno-fast-math"])
for flag in ("-ffast-math", "-Ofast", "-march=native"):
    for var in ("CCFLAGS", "CXXFLAGS", "LINKFLAGS"):
        if flag in [str(f) for f in env.get(var, [])]:
            raise SCons.Errors.UserError(f"{flag} is forbidden (FND-02)")

if env["target"] == "template_debug":
    env.Append(CPPDEFINES=["LB_DEBUG_TOOLS"])

# Extra library dirs, e.g. a user-local libstdc++.a for static linking (see build_native.sh).
for libdir in os.environ.get("LB_EXTRA_LIBPATH", "").split(os.pathsep):
    if libdir:
        env.Append(LIBPATH=[libdir])


def version_stamp():
    """Writes src/core/version.gen.h: the game version from versions.json and the git SHA."""
    root = os.path.abspath(os.path.join(Dir("#").abspath, ".."))
    with open(os.path.join(root, "versions.json")) as f:
        version = json.load(f)["game"]["version"]
    try:
        sha = subprocess.check_output(
            ["git", "-C", root, "rev-parse", "--short=7", "HEAD"], stderr=subprocess.DEVNULL
        ).decode().strip()
    except (subprocess.CalledProcessError, OSError):
        sha = "nogit"
    text = (
        "// Generated by native/SConstruct. Do not edit.\n#pragma once\n"
        f'#define LB_VERSION "{version}"\n#define LB_GIT_SHA "{sha}"\n'
    )
    path = os.path.join(Dir("#").abspath, "src", "core", "version.gen.h")
    if not os.path.exists(path) or open(path).read() != text:
        with open(path, "w") as f:
            f.write(text)


version_stamp()

if env["platform"] == "windows":
    env.Append(LIBS=["winmm"])  # timeBeginPeriod (NET-01's tick clock)

# SND-05: the voice capture's libraries (WebRTC audio processing, SpeexDSP, miniaudio).
VOICE_INCLUDES = ["thirdparty/webrtc-apm/webrtc", "thirdparty/webrtc-apm", "thirdparty/webrtc-apm/abseil",
                  "thirdparty/speexdsp/include", "thirdparty/miniaudio"]
# WebRTC's headers read the platform from these, in our code as in its own.
WEBRTC_PLATFORM = (["WEBRTC_WIN", "NOMINMAX", "_USE_MATH_DEFINES"] if env["platform"] == "windows"
                   else ["WEBRTC_POSIX", "WEBRTC_LINUX"])

env.Append(CPPPATH=["src/", "thirdparty/steamaudio/include", "thirdparty/opus/include"] + VOICE_INCLUDES)
env.Append(CPPDEFINES=WEBRTC_PLATFORM)
if env["platform"] == "linux":
    env.Append(LIBS=["dl", "pthread", "m"])  # SND-04: Steam Audio is loaded at run time; SND-05's threads
core_sources = Glob("src/core/*.cpp") + Glob("src/core/*/*.cpp")


def opus_sources():
    """SND-07, SND-13: libopus 1.6's float build, from its own source lists (thirdparty/opus)."""
    import re
    files = []
    for mk, lists in (("opus_sources.mk", ("OPUS_SOURCES", "OPUS_SOURCES_FLOAT")), ("celt_sources.mk", ("CELT_SOURCES",)),
                      ("silk_sources.mk", ("SILK_SOURCES", "SILK_SOURCES_FLOAT"))):
        text = open(os.path.join(Dir("#").abspath, "thirdparty", "opus", mk)).read().replace("\\\n", " ")
        for name in lists:
            m = re.search(r"^" + name + r"\s*=\s*(.*)$", text, re.M)
            files += ["thirdparty/opus/" + f for f in m.group(1).split()]
    return files


def opus_objects(base_env, suffix):
    """libopus compiled with `base_env`'s compiler: plain C, warnings off, no SIMD dispatch."""
    o = base_env.Clone()
    o.Append(CPPDEFINES=["OPUS_BUILD", "USE_ALLOCA", "HAVE_LRINTF", "HAVE_LRINT", ("PACKAGE_VERSION", '\\"1.6\\"')])
    o.Append(CPPPATH=["thirdparty/opus/include", "thirdparty/opus/celt", "thirdparty/opus/silk",
                      "thirdparty/opus/silk/float", "thirdparty/opus/src"])
    if not o.get("is_msvc", False):
        o.Append(CFLAGS=["-w", "-O2"])
    o["OBJSUFFIX"] = suffix + o["OBJSUFFIX"]
    return [o.SharedObject(f) if suffix == ".lib" else o.Object(f) for f in opus_sources()]


def voice_objects(base_env, suffix):
    """SND-05: WebRTC audio processing 2.1 (with the eight abseil files it links), SpeexDSP 1.2.1 and
    miniaudio 0.11.25, compiled with `base_env`'s compiler: warnings off, NDEBUG in both targets (no
    WebRTC debug checks, and its debug dumps compiled out), and WebRTC's AVX2/SSE2 kernels with their
    own ISA flags behind its runtime CPU dispatch (thirdparty/webrtc-apm/sources.txt)."""
    msvc = base_env.get("is_msvc", False)
    objects = []

    def compile_with(e, path):
        return e.SharedObject(path) if suffix == ".lib" else e.Object(path)

    w = base_env.Clone()
    w.Append(CPPDEFINES=["NDEBUG", ("WEBRTC_APM_DEBUG_DUMP", "0"), "WEBRTC_ENABLE_AVX2", "WEBRTC_LIBRARY_IMPL",
                         "__STDC_FORMAT_MACROS"] + (["_WINSOCKAPI_"] if env["platform"] == "windows" else []))
    w.Append(CPPPATH=VOICE_INCLUDES)
    if msvc:
        w.Append(CXXFLAGS=["/FIcstdint"])
    else:
        w.Append(CCFLAGS=["-w", "-O2"], CXXFLAGS=["-include", "cstdint"])
    w["OBJSUFFIX"] = suffix + ".apm" + w["OBJSUFFIX"]
    listing = os.path.join(Dir("#").abspath, "thirdparty", "webrtc-apm", "sources.txt")
    for line in open(listing):
        parts = line.split()
        if not parts or parts[0].startswith("#"):
            continue
        e = w
        if len(parts) > 1 and not msvc:
            e = w.Clone()
            e.Append(CCFLAGS=parts[1:])
        objects.append(compile_with(e, "thirdparty/webrtc-apm/" + parts[0]))

    sp = base_env.Clone()
    sp.Append(CPPDEFINES=["FLOATING_POINT", "USE_SMALLFT", ("EXPORT", "")])
    sp.Append(CPPPATH=["thirdparty/speexdsp/include"])
    if not msvc:
        sp.Append(CFLAGS=["-w", "-O2"])
    sp["OBJSUFFIX"] = suffix + ".spx" + sp["OBJSUFFIX"]
    for f in ("mdf", "preprocess", "fftwrap", "smallft", "filterbank", "resample"):
        objects.append(compile_with(sp, "thirdparty/speexdsp/libspeexdsp/%s.c" % f))

    ma = base_env.Clone()
    if not msvc:
        ma.Append(CFLAGS=["-w", "-O2"])
    ma["OBJSUFFIX"] = suffix + ".ma" + ma["OBJSUFFIX"]
    objects.append(compile_with(ma, "thirdparty/miniaudio/lb_miniaudio_impl.c"))
    return objects


# SND-04: Steam Audio's runtime beside the core library (loaded, never linked).
phonon = {"linux": "thirdparty/steamaudio/lib/linux-x64/libphonon.so",
          "windows": "thirdparty/steamaudio/lib/windows-x64/phonon.dll"}.get(env["platform"])
if phonon:
    Default(env.Install("bin", phonon))
godot_sources = Glob("src/godot/*.cpp") + Glob("src/godot/*/*.cpp") + ["src/register_types.cpp"]
# NET-08's reference visibility: dev and QA libraries (and the doctests) only, never a release one.
audit_sources = Glob("src/audit/*.cpp")
# GEN-14's seed harness: likewise dev and QA libraries and the doctests only.
harness_sources = Glob("src/harness/*.cpp")
debug_sources = audit_sources + harness_sources

library = env.SharedLibrary(
    "bin/liblampblack_core{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=core_sources + godot_sources + (debug_sources if env["target"] == "template_debug" else [])
    + opus_objects(env, ".lib") + voice_objects(env, ".lib"),
)
env.NoCache(library)
Default(library)

# The doctest runner links src/core only, never godot-cpp.
if ARGUMENTS.get("tests", "no") in ("yes", "true", "1"):
    test_env = Environment(ENV=os.environ, CXX=env["CXX"], CC=env["CC"])
    if env.get("is_msvc", False):
        test_env.Append(CXXFLAGS=["/std:c++17", "/fp:precise", "/EHsc"])
    else:
        test_env.Append(CXXFLAGS=["-std=c++17", "-ffp-contract=off", "-fno-fast-math", "-O2", "-g"])
    if env["target"] == "template_debug":
        test_env.Append(CPPDEFINES=["LB_DEBUG_TOOLS"])
    if env["platform"] == "windows" and not env.get("is_msvc", False):
        # MinGW: a self-contained .exe, runnable under Wine without MinGW's DLLs.
        test_env["PROGSUFFIX"] = ".exe"
        test_env.Append(LINKFLAGS=["-static"])
    elif env["platform"] == "linux":
        test_env.Append(LINKFLAGS=["-static-libstdc++", "-static-libgcc"])
        for libdir in os.environ.get("LB_EXTRA_LIBPATH", "").split(os.pathsep):
            if libdir:
                test_env.Append(LIBPATH=[libdir])
    test_env.Append(CPPPATH=["src/", "thirdparty/doctest/", "thirdparty/steamaudio/include", "thirdparty/opus/include"] + VOICE_INCLUDES)
    test_env.Append(CPPDEFINES=WEBRTC_PLATFORM)
    if env["platform"] == "linux":
        test_env.Append(LIBS=["dl", "pthread", "m"])
    else:
        test_env.Append(LIBS=["winmm"])
    test_env["OBJSUFFIX"] = ".tests" + env["suffix"] + test_env["OBJSUFFIX"]
    test_sources = [f for f in Glob("tests/*.cpp") if not f.name.endswith("digest_main.cpp")] + Glob("tests/harness/*.cpp")
    test_opus = opus_objects(test_env, ".tests" + env["suffix"]) + voice_objects(test_env, ".tests" + env["suffix"])
    tests = test_env.Program(
        "bin/lampblack_core_tests{}{}".format(env["suffix"], test_env["PROGSUFFIX"]),
        source=test_sources + core_sources + [test_env.Object(f) for f in debug_sources] + test_opus,
    )
    digest = test_env.Program(
        "bin/lampblack_core_digest{}{}".format(env["suffix"], test_env["PROGSUFFIX"]),
        source=["tests/digest_main.cpp"] + [test_env.Object(f) for f in core_sources] + test_opus,
    )
    Default(tests, digest)
