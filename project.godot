; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LAMPBLACK"
config/description="A 2D top-down online co-op horror game."
run/main_scene="res://shared/boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/flush_stdout_on_print=true
config/icon="res://shared/boot/icon.png"

[autoload]

Tuning="*res://shared/tuning/tuning.gd"

[debug]

gdscript/warnings/directory_rules={
"res://addons": 0
}
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/unused_variable=2
gdscript/warnings/shadowed_variable=2
gdscript/warnings/unreachable_code=2

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[lampblack]

steam/app_id=5110670
steam/app_id.lb_release=5110670

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
