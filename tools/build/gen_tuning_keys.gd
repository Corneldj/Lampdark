extends SceneTree
## Writes shared/tuning/tuning_keys.gd: one StringName constant per tuning key, so a typo in
## a key fails at parse time (FND-05). With --check, writes nothing and exits 1 if the file
## is stale. Usage: godot --headless --path <game> -s tools/build/gen_tuning_keys.gd [-- --check]

const OUTPUT: String = "res://shared/tuning/tuning_keys.gd"


func _init() -> void:
	var tuning: TuningSet = TuningSet.new()
	var errors: Array[String] = tuning.load_directory(TuningSet.DATA_DIR)
	if not errors.is_empty():
		for error: String in errors:
			printerr(error)
		quit(1)
		return
	var text: String = render(tuning)
	if "--check" in OS.get_cmdline_user_args():
		if FileAccess.get_file_as_string(OUTPUT) != text:
			printerr("gen_tuning_keys: %s is stale; run tools/build/gen_tuning_keys.gd" % OUTPUT)
			quit(1)
			return
		print("gen_tuning_keys: up to date (%d keys)" % tuning.entries.size())
		quit(0)
		return
	var file: FileAccess = FileAccess.open(OUTPUT, FileAccess.WRITE)
	file.store_string(text)
	file.close()
	print("gen_tuning_keys: wrote %d keys to %s" % [tuning.entries.size(), OUTPUT])
	quit(0)


static func render(tuning: TuningSet) -> String:
	var keys: Array = tuning.entries.keys()
	keys.sort()
	var lines: PackedStringArray = PackedStringArray([
		"class_name TK",
		"## Tuning key constants, generated by tools/build/gen_tuning_keys.gd from data/tuning.",
		"## Do not edit by hand. CI fails if this file is stale.",
		"",
	])
	for key: Variant in keys:
		lines.append("const %s: StringName = &\"%s\"" % [str(key).to_upper().replace(".", "_"), key])
	return "\n".join(lines) + "\n"
