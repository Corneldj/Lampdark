extends SceneTree
## Generates ID constants shared by C++ and GDScript from the registries in shared/ids/
## (FND-06 hash domains; FND-07 adds its kinds). With --check, writes nothing and exits 1 if
## any generated file is stale.
## Usage: godot --headless --path <game> -s tools/build/gen_ids.gd [-- --check]

const DOMAINS_JSON: String = "res://shared/ids/hash_domains.json"
const DOMAINS_GD: String = "res://shared/ids/hash_domains.gd"
const DOMAINS_H: String = "res://native/src/core/generated/hash_domains.h"
const WORLD_JSON: String = "res://shared/ids/world_ids.json"
const WORLD_GD: String = "res://shared/ids/world_ids.gd"
const WORLD_H: String = "res://native/src/core/generated/world_ids.h"


func _initialize() -> void:
	var problems: Array[String] = []
	var domains: Array[Dictionary] = read_domains(DOMAINS_JSON, problems)
	var world: Dictionary = read_world(WORLD_JSON, problems)
	if not problems.is_empty():
		_fail(problems)
		return
	var outputs: Dictionary = {
		DOMAINS_GD: render_gd(domains),
		DOMAINS_H: render_h(domains),
		WORLD_GD: render_world_gd(world),
		WORLD_H: render_world_h(world),
	}
	var check: bool = "--check" in OS.get_cmdline_user_args()
	for path: String in outputs.keys():
		var text: String = outputs[path]
		if check:
			if FileAccess.get_file_as_string(path) != text:
				problems.append("%s is stale; run tools/build/gen_ids.gd" % path)
		else:
			DirAccess.make_dir_recursive_absolute(path.get_base_dir())
			var file: FileAccess = FileAccess.open(path, FileAccess.WRITE)
			file.store_string(text)
			file.close()
	if not problems.is_empty():
		_fail(problems)
		return
	print("gen_ids: %s %d hash domains, %d materials, %d entity kinds" % ["checked" if check else "wrote",
		domains.size(), Variants.array(world["materials"]).size(), Variants.array(world["entity_kinds"]).size()])
	quit(0)


func _fail(problems: Array[String]) -> void:
	for problem: String in problems:
		printerr("gen_ids: " + problem)
	quit(1)


## Reads and validates the registry: unique names and IDs, IDs positive, names dotted lower case.
static func read_domains(path: String, problems: Array[String]) -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
	var names: Dictionary = {}
	var ids: Dictionary = {}
	var name_pattern: RegEx = RegEx.create_from_string("^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$")
	for raw: Variant in Variants.array(Variants.dict(parsed).get("domains", [])):
		var entry: Dictionary = Variants.dict(raw)
		var name: String = str(entry.get("name", ""))
		var id: int = int(Variants.number(entry.get("id", 0)))
		if name_pattern.search(name) == null:
			problems.append("bad domain name '%s'" % name)
		if id <= 0:
			problems.append("%s: id must be a positive integer" % name)
		if names.has(name):
			problems.append("duplicate domain name %s" % name)
		if ids.has(id):
			problems.append("duplicate domain id %d (%s and %s)" % [id, ids[id], name])
		names[name] = id
		ids[id] = name
		out.append({"name": name, "id": id, "owner": str(entry.get("owner", "")), "kind": str(entry.get("kind", ""))})
	if out.is_empty():
		problems.append("%s holds no domains" % path)
	return out


static func constant_name(domain_name: String) -> String:
	return domain_name.to_upper().replace(".", "_")


static func render_gd(domains: Array[Dictionary]) -> String:
	var lines: PackedStringArray = PackedStringArray([
		"class_name HashDomain",
		"## Hash domain IDs, generated by tools/build/gen_ids.gd from shared/ids/hash_domains.json.",
		"## Do not edit by hand. CI fails if this file is stale.",
		"",
	])
	for entry: Dictionary in domains:
		lines.append("const %s: int = %d  # %s, %s" % [constant_name(str(entry["name"])), entry["id"], entry["kind"], entry["owner"]])
	lines.append("")
	lines.append("const ALL: Dictionary = {")
	for entry: Dictionary in domains:
		lines.append("\t\"%s\": %d," % [entry["name"], entry["id"]])
	lines.append("}")
	return "\n".join(lines) + "\n"


static func render_h(domains: Array[Dictionary]) -> String:
	var lines: PackedStringArray = PackedStringArray([
		"#pragma once",
		"// Hash domain IDs, generated by tools/build/gen_ids.gd from shared/ids/hash_domains.json.",
		"// Do not edit by hand. CI fails if this file is stale.",
		"",
		"#include <cstddef>",
		"#include <cstdint>",
		"",
		"namespace lb::core::hash_domain {",
		"",
	])
	for entry: Dictionary in domains:
		lines.append("constexpr uint64_t %s = %d; // %s, %s" % [constant_name(str(entry["name"])), entry["id"], entry["kind"], entry["owner"]])
	lines.append("")
	lines.append("struct Entry {")
	lines.append("\tconst char *name;")
	lines.append("\tuint64_t id;")
	lines.append("};")
	lines.append("")
	lines.append("constexpr Entry ALL[] = {")
	for entry: Dictionary in domains:
		lines.append("\t{\"%s\", %d}," % [entry["name"], entry["id"]])
	lines.append("};")
	lines.append("constexpr size_t COUNT = sizeof(ALL) / sizeof(ALL[0]);")
	lines.append("")
	lines.append("} // namespace lb::core::hash_domain")
	return "\n".join(lines) + "\n"


## Reads world_ids.json: integer constants, materials (ids from 0, unique) and entity kinds
## (ids from 1; 0 is "none"), each name UPPER_SNAKE.
static func read_world(path: String, problems: Array[String]) -> Dictionary:
	var parsed: Dictionary = Variants.dict(JSON.parse_string(FileAccess.get_file_as_string(path)))
	var name_pattern: RegEx = RegEx.create_from_string("^[A-Z][A-Z0-9_]*$")
	var constants: Dictionary = {}
	var raw_constants: Dictionary = Variants.dict(parsed.get("constants", {}))
	for name: Variant in raw_constants.keys():
		var value: float = Variants.number(raw_constants[name])
		if name_pattern.search(str(name)) == null or value != floorf(value):
			problems.append("world constant %s must be UPPER_SNAKE with an integer value" % name)
		constants[str(name)] = int(value)
	var out: Dictionary = {"constants": constants}
	for list_name: String in ["materials", "entity_kinds"]:
		var entries: Array[Dictionary] = []
		var seen_ids: Dictionary = {}
		var min_id: int = 0 if list_name == "materials" else 1
		for raw: Variant in Variants.array(parsed.get(list_name, [])):
			var entry: Dictionary = Variants.dict(raw)
			var name: String = str(entry.get("name", ""))
			var id: int = int(Variants.number(entry.get("id", -1)))
			if name_pattern.search(name) == null:
				problems.append("%s: bad name '%s'" % [list_name, name])
			if id < min_id or seen_ids.has(id):
				problems.append("%s: %s has a missing, duplicate or out-of-range id %d" % [list_name, name, id])
			seen_ids[id] = true
			entries.append({"name": name, "id": id, "caption_key": str(entry.get("caption_key", ""))})
		if entries.is_empty():
			problems.append("%s holds no %s" % [path, list_name])
		out[list_name] = entries
	return out


static func render_world_gd(world: Dictionary) -> String:
	var lines: PackedStringArray = PackedStringArray([
		"class_name WorldIds",
		"## World units and identifiers, generated by tools/build/gen_ids.gd from shared/ids/world_ids.json.",
		"## Do not edit by hand. CI fails if this file is stale.",
		"",
	])
	var constants: Dictionary = world["constants"]
	for name: Variant in constants.keys():
		lines.append("const %s: int = %d" % [name, constants[name]])
	lines.append("")
	lines.append("enum TileMaterial {")
	for entry: Dictionary in Variants.array(world["materials"]):
		lines.append("\t%s = %d," % [entry["name"], entry["id"]])
	lines.append("}")
	lines.append("")
	lines.append("## Bump caption translation key per material; \"\" where a material has none.")
	lines.append("const MATERIAL_CAPTION_KEYS: Dictionary = {")
	for entry: Dictionary in Variants.array(world["materials"]):
		lines.append("\tTileMaterial.%s: \"%s\"," % [entry["name"], entry["caption_key"]])
	lines.append("}")
	lines.append("")
	lines.append("## Server vocabulary only: never sent to a client (NET-04 sends per-client tokens).")
	lines.append("enum EntityKind {")
	lines.append("\tNONE = 0,")
	for entry: Dictionary in Variants.array(world["entity_kinds"]):
		lines.append("\t%s = %d," % [entry["name"], entry["id"]])
	lines.append("}")
	return "\n".join(lines) + "\n"


static func render_world_h(world: Dictionary) -> String:
	var lines: PackedStringArray = PackedStringArray([
		"#pragma once",
		"// World units and identifiers, generated by tools/build/gen_ids.gd from shared/ids/world_ids.json.",
		"// Do not edit by hand. CI fails if this file is stale.",
		"",
		"#include <cstdint>",
		"",
		"namespace lb::core::world {",
		"",
	])
	var constants: Dictionary = world["constants"]
	for name: Variant in constants.keys():
		lines.append("constexpr int64_t %s = %d;" % [name, constants[name]])
	lines.append("")
	lines.append("enum class TileMaterial : uint8_t {")
	for entry: Dictionary in Variants.array(world["materials"]):
		lines.append("\t%s = %d," % [entry["name"], entry["id"]])
	lines.append("};")
	lines.append("")
	lines.append("// Bump caption translation key; \"\" where a material has none.")
	lines.append("constexpr const char *material_caption_key(TileMaterial material) {")
	lines.append("\tswitch (material) {")
	for entry: Dictionary in Variants.array(world["materials"]):
		lines.append("\t\tcase TileMaterial::%s: return \"%s\";" % [entry["name"], entry["caption_key"]])
	lines.append("\t}")
	lines.append("\treturn \"\";")
	lines.append("}")
	lines.append("")
	lines.append("// Server vocabulary only: never sent to a client (NET-04 sends per-client tokens).")
	lines.append("enum class EntityKind : uint16_t {")
	lines.append("\tNONE = 0,")
	for entry: Dictionary in Variants.array(world["entity_kinds"]):
		lines.append("\t%s = %d," % [entry["name"], entry["id"]])
	lines.append("};")
	lines.append("")
	lines.append("} // namespace lb::core::world")
	return "\n".join(lines) + "\n"
