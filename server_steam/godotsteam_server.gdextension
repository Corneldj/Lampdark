; STM-04's Path A: GodotSteam Server GDExtension 4.12.1 (Steamworks SDK 1.65), pinned in versions.json.
; Never part of the project (.gdignore): it cannot share a process with GodotSteam (both register
; SteamProjectSettings). tools/build/export_all.sh copies this folder beside each server export as
; steam_server/, and an exported server loads it at run time (SteamServerApi.load_extension).
[configuration]
entry_symbol = "godotsteam_server_init"
compatibility_minimum = "4.4"

[libraries]
linux.debug.x86_64 = "linux64/libgodotsteam_server.linux.template_debug.x86_64.so"
linux.release.x86_64 = "linux64/libgodotsteam_server.linux.template_release.x86_64.so"
windows.debug.x86_64 = "win64/libgodotsteam_server.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "win64/libgodotsteam_server.windows.template_release.x86_64.dll"

[dependencies]
linux.x86_64 = { "linux64/libsteam_api.so": "" }
windows.x86_64 = { "win64/steam_api64.dll": "" }
