* text=auto eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf

# Golden files hold the same bytes on every platform (FND-06)
*.golden -text

# Binary assets go through Git LFS
*.png filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text

# Vendored native runtimes (SND-04's Steam Audio) go through Git LFS
native/thirdparty/steamaudio/lib/** filter=lfs diff=lfs merge=lfs -text
addons/godotsteam/linux64/** filter=lfs diff=lfs merge=lfs -text
addons/godotsteam/win64/** filter=lfs diff=lfs merge=lfs -text
server_steam/linux64/** filter=lfs diff=lfs merge=lfs -text
server_steam/win64/** filter=lfs diff=lfs merge=lfs -text
